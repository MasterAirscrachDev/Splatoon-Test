  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Sniper
  displayName: Sniper
  description: 'Hold to charge (a laser shows the line), let go to fire a shot straight
    down the line: the longer the charge, the farther and harder. A full charge splats
    in one hit. Ink falls all along its line.'
  icon: {fileID: 21300000, guid: 6edf32f3778246d46ae647f903b31de1, type: 3}
  powerRating: 0.95
  rangeRating: 0.95
  speedRating: 0.2
  feetShotInterval: 0.4
  feetShotMinSize: 12
  feetShotMaxSize: 18
  feetShotDropSpeed: 6
  chargeTime: 1.2
  chargeMoveSpeed: 1
  swimHoldTime: 0
  muzzle: {fileID: 1680032179521317830}
  range: {x: 10, y: 26}
  damage: {x: 20, y: 160}
  shotSpeed: 120
  shotSplat: 12
  aimPitchLimits: {x: -50, y: 60}
  inkCost: 180
  minInkShare: 0.3
  lineSpacing: 0.6
  lineSplat: {x: 5, y: 10}
  lineFallSpeed: 4
  lineLook:
    size: 0.8
    stretch: 0.1
    companions: 1
    companionSize: {x: 0.5, y: 0.85}
    upDownSpread: 2
    sideSpread: 2
    speedSpread: 0.05
  laserWidth: 0.04
  laserAlpha: 0.8
  laserGrey: 0.45
  laserShade: 0.7
  glowSize: 0.07
  glowRange: 1.5
  glowIntensity: 2
