#pragma kernel Splat
#pragma kernel GetScores
#pragma kernel GetTopScores
#pragma kernel ComputeNormals
#pragma kernel PaintTrailNormal
#pragma kernel FillRegion

RWTexture2D<float4> InkTexture;      // per-team coverage: r = alpha team, g = beta team (0..1); b, a unused
RWTexture2D<float4> NormalTexture;   // runtime ink normal map (RGB-encoded), written by ComputeNormals
Texture2D<float> TopMask;   // 1 = pixel belongs to a floor/slope face, 0 = wall (used by GetTopScores)
float NormalStrength;       // slope of the ink rim — higher = more pronounced bump
float NoiseStrength;        // amplitude of the surface noise that breaks up flat ink tops
float NoiseScale;           // frequency of that noise (in noise-cells per texel)
float SeamHeight;           // height of the ridge where two teams' ink meets
// A group of splats applied in one dispatch (SurfaceInkManager.FlushSplats), in order.
struct SplatInfo { int2 centre; int radius; int team; };
StructuredBuffer<SplatInfo> Splats;
int SplatCount;
int2 BoundsMin;        // texel-space origin of the current dispatch's bounding box
int Size;
int MaskToSplat;       // when nonzero, ComputeNormals only rewrites texels the current splats reached
float2 TrailCenter;    // texel-space centre of a PaintTrailNormal stamp
float TrailRadius;     // texel radius of that stamp
float TrailDepth;      // steepness of the fully-formed indent
float TrailBlend;      // 0..1 — how far one stamp eases the normal toward the indent shape
float4 FillColor;      // coverage written by FillRegion: (1,0,0,0) alpha, (0,1,0,0) beta, 0 erases
int4 FillRect;         // FillRegion texel rect: xy = min (inclusive), zw = max (exclusive)
RWStructuredBuffer<int> TeamScores;

// Dave Hoskins hash: no diagonal artifacts at large coordinates, unlike frac(dot(...)).
float hash21(float2 p) {
    float3 p3 = frac(float3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

// Bilinearly interpolated value noise — smooth blobs instead of per-pixel speckle
float valueNoise(float2 p) {
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f); // smoothstep curve
    return lerp(
        lerp(hash21(i + float2(0,0)), hash21(i + float2(1,0)), u.x),
        lerp(hash21(i + float2(0,1)), hash21(i + float2(1,1)), u.x),
        u.y
    );
}

// Owning team at a texel: the higher coverage, if at least half covered (0 = none).
int TeamOf(float4 ink) {
    if (max(ink.r, ink.g) < 0.5) return 0;
    return ink.r >= ink.g ? 1 : 2;
}

// Alpha a splat contributes at a texel (0 outside its blob and feather band).
float SplatAlpha(int2 texel, SplatInfo s) {
    float r = (float)s.radius;
    if (r <= 0) return 0.0;
    int reach = (int)ceil(r * 1.4) + 4; // domain warp pushes the edge out up to r*0.4, plus feather
    if (abs(texel.x - s.centre.x) > reach || abs(texel.y - s.centre.y) > reach) return 0.0;

    float dx = texel.x - s.centre.x;
    float dy = texel.y - s.centre.y;
    float2 p = float2(texel);

    // Domain warp: two noise channels displace the distance field into organic lobes.
    float freq = 3.5 / max(r, 1.0); // ~7 lobes regardless of splat pixel radius
    float amp  = r * 0.4;
    float wx = (valueNoise(p * freq)                      - 0.5) * amp;
    float wy = (valueNoise(p * freq + float2(31.7, 17.3)) - 0.5) * amp;

    float dist = length(float2(dx - wx, dy - wy));

    // Feather scales with the splat radius, so edge softness is proportional on every surface.
    float featherHalfWidth = clamp(r * 0.5, 1.0, 4.0);
    return 1.0 - smoothstep(-featherHalfWidth, featherHalfWidth, dist - r);
}

// Strongest alpha any of the current splats gives a texel.
float SplatsAlpha(int2 texel) {
    float a = 0.0;
    for (int i = 0; i < SplatCount; i++) a = max(a, SplatAlpha(texel, Splats[i]));
    return a;
}

// Dispatched only over the group's bounding box (BoundsMin). Each splat, in order, raises its
// team's coverage to its soft-edged shape and pulls the other team's down to match, so where
// teams meet the crossing point (r == g) keeps the splat's sub-texel smoothness. One thread does
// a texel's splats in turn: the same as splatting them one by one.
[numthreads(8,8,1)]
void Splat(uint3 id : SV_DispatchThreadID) {
    int2 texel = BoundsMin + int2(id.xy);
    if (texel.x < 0 || texel.y < 0 || texel.x >= Size || texel.y >= Size) return;
    float4 ink = InkTexture[texel];
    bool touched = false;
    for (int i = 0; i < SplatCount; i++) {
        SplatInfo sp = Splats[i];
        float s = SplatAlpha(texel, sp);
        if (s < 0.01) continue;
        if (sp.team == 1) { ink.r = max(ink.r, s); ink.g = min(ink.g, 1.0 - s); }
        else              { ink.g = max(ink.g, s); ink.r = min(ink.r, 1.0 - s); }
        touched = true;
    }
    if (touched) InkTexture[texel] = ink;
}

[numthreads(8,8,1)]
void GetScores(uint3 id : SV_DispatchThreadID) {
    int team = TeamOf(InkTexture[int2(id.x, id.y)]);
    InterlockedAdd(TeamScores[team == 0 ? 2 : team - 1], 1); // [alpha, beta, neutral]
}

// GetScores for floor/slope texels only (TopMask); neutral is derived on the CPU.
[numthreads(8,8,1)]
void GetTopScores(uint3 id : SV_DispatchThreadID) {
    if (TopMask.Load(int3(id.x, id.y, 0)) < 0.5) return;
    int team = TeamOf(InkTexture[int2(id.x, id.y)]);
    if (team != 0) InterlockedAdd(TeamScores[team - 1], 1);
}

// Total coverage as height, perturbed by zero-centred noise so ink tops aren't flat, plus a
// ridge where both teams are present (2*min peaks at the boundary, 0 under one team's ink).
float InkHeight(int2 c) {
    float4 ink = InkTexture[c];
    float coverage = saturate(ink.r + ink.g);
    float n = valueNoise(float2(c.x, c.y) * NoiseScale) - 0.5;
    float seam = 2.0 * min(ink.r, ink.g);
    return coverage * (1.0 + n * NoiseStrength) + seam * SeamHeight;
}

// Tangent-space normals from the ink height field (central differences), RGB-encoded.
// With MaskToSplat, only texels the current splats reached are rebuilt, so trail indents survive.
[numthreads(8,8,1)]
void ComputeNormals(uint3 id : SV_DispatchThreadID) {
    int2 texel = BoundsMin + int2(id.xy);
    if (texel.x < 0 || texel.y < 0 || texel.x >= Size || texel.y >= Size) return;
    if (MaskToSplat != 0 && SplatsAlpha(texel) < 0.01) return;
    int x = texel.x, y = texel.y;
    int xl = max(x - 1, 0), xr = min(x + 1, Size - 1);
    int yd = max(y - 1, 0), yu = min(y + 1, Size - 1);

    float hl = InkHeight(int2(xl, y));
    float hr = InkHeight(int2(xr, y));
    float hd = InkHeight(int2(x, yd));
    float hu = InkHeight(int2(x, yu));

    float3 n = normalize(float3((hl - hr) * NormalStrength, (hd - hu) * NormalStrength, 1.0));
    NormalTexture[texel] = float4(n * 0.5 + 0.5, 1.0);
}

// Smooth circular dip: deepest at TrailCenter, flat at TrailRadius.
float TrailHeight(float2 texelPos) {
    float dist = length(texelPos - TrailCenter);
    return -smoothstep(TrailRadius, 0.0, dist) * TrailDepth;
}

// Stamps a trail indent into the normal map only, eased in by TrailBlend so repeats converge.
[numthreads(8,8,1)]
void PaintTrailNormal(uint3 id : SV_DispatchThreadID) {
    int2 texel = BoundsMin + int2(id.xy);
    if (texel.x < 0 || texel.y < 0 || texel.x >= Size || texel.y >= Size) return;

    float2 p = float2(texel);
    float hl = TrailHeight(p + float2(-1, 0));
    float hr = TrailHeight(p + float2( 1, 0));
    float hd = TrailHeight(p + float2( 0,-1));
    float hu = TrailHeight(p + float2( 0, 1));

    float3 dentNormal = normalize(float3(hl - hr, hd - hu, 1.0));

    float3 existing = NormalTexture[texel].xyz * 2.0 - 1.0;
    float3 blended  = normalize(lerp(existing, dentNormal, TrailBlend));
    NormalTexture[texel] = float4(blended * 0.5 + 0.5, 1.0);
}

// Solid fill over FillRect, for setting up known ink states (tests, tools).
[numthreads(8,8,1)]
void FillRegion(uint3 id : SV_DispatchThreadID) {
    int2 texel = BoundsMin + int2(id.xy);
    if (any(texel < FillRect.xy) || any(texel >= FillRect.zw)) return;
    if (texel.x >= Size || texel.y >= Size) return;
    InkTexture[texel] = FillColor;
}
