#pragma kernel Splat
#pragma kernel GetScores
#pragma kernel GetTeamAtPixel

RWTexture2D<float4> InkTexture;
float4 AlphaColor;
float4 BetaColor;
float4 NoColor;
int2 PixelCoords;      // used by Splat
int2 TeamQueryCoords;  // used by GetTeamAtPixel (separate to avoid clobbering)
int Size;
int Team;
int SplashSize;
RWStructuredBuffer<int> TeamScores;
RWStructuredBuffer<int> PixelTeam;

float hash21(float2 p) {
    p = frac(p * float2(127.1, 311.7));
    return frac(dot(p, p + 19.19));
}

// Bilinearly interpolated value noise — smooth blobs instead of per-pixel speckle
float valueNoise(float2 p) {
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f); // smoothstep curve
    return lerp(
        lerp(hash21(i + float2(0,0)), hash21(i + float2(1,0)), u.x),
        lerp(hash21(i + float2(0,1)), hash21(i + float2(1,1)), u.x),
        u.y
    );
}

// Pixels with faded alpha (edge band) count as painted only when majority solid.
// Comparing only RGB survives ARGB32 quantisation (~0.004 error per channel).
bool ColorNear(float4 a, float4 b) {
    return a.a > 0.5 && all(abs(a.rgb - b.rgb) < 0.01);
}

float4 GetColor(int2 PixCoords, int3 id, int radius, float4 old) {
    float dx = id.x - PixCoords.x;
    float dy = id.y - PixCoords.y;
    float dist2 = dx * dx + dy * dy;
    float r = (float)radius;

    float coreR  = r * 0.8;
    float outerR = r * 1.2;

    if (dist2 >= outerR * outerR) return old;

    // Solid core: inner 80% of radius always painted
    if (dist2 < coreR * coreR) {
        if (Team == 1) return AlphaColor;
        if (Team == 2) return BetaColor;
        return old;
    }

    // Narrow organic edge band (80% → 120%): smooth value noise decides shape,
    // alpha fades from 1 at the core boundary to 0 at the outer boundary so the
    // display shader gets a real gradient instead of a hard pixel edge.
    float coreR2  = coreR  * coreR;
    float outerR2 = outerR * outerR;
    float t = (dist2 - coreR2) / (outerR2 - coreR2); // 0 at core, 1 at outer
    float n = valueNoise(float2(id.x, id.y) * 0.06);
    if (n > t) {
        float4 color = (Team == 1) ? AlphaColor : BetaColor;
        color.a = 1.0 - t;
        // Never weaken existing ink: a faded edge must not overwrite a more solid pixel.
        // Solid cores (alpha=1) still always win because GetColor returns AlphaColor/BetaColor
        // with full alpha before reaching this band.
        if (old.a >= color.a) return old;
        return color;
    }
    return old;
}

[numthreads(8,8,1)]
void Splat(uint3 id : SV_DispatchThreadID) {
    InkTexture[int2(id.x, id.y)] = GetColor(PixelCoords, id, SplashSize, InkTexture[int2(id.x, id.y)]);
}

[numthreads(8,8,1)]
void GetScores(uint3 id : SV_DispatchThreadID) {
    float4 color = InkTexture[int2(id.x, id.y)];
    if (ColorNear(color, AlphaColor)) {
        InterlockedAdd(TeamScores[0], 1);
    } else if (ColorNear(color, BetaColor)) {
        InterlockedAdd(TeamScores[1], 1);
    } else {
        InterlockedAdd(TeamScores[2], 1);
    }
}

// Single-thread kernel: reads one pixel and writes team id (0/1/2) to PixelTeam[0]
[numthreads(1,1,1)]
void GetTeamAtPixel(uint3 id : SV_DispatchThreadID) {
    float4 color = InkTexture[TeamQueryCoords];
    if (ColorNear(color, AlphaColor)) {
        PixelTeam[0] = 1;
    } else if (ColorNear(color, BetaColor)) {
        PixelTeam[0] = 2;
    } else {
        PixelTeam[0] = 0;
    }
}
